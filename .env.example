# ==============================================================================
# LumiChart — Enterprise Environment Variables Configuration
# ==============================================================================
# Ce fichier recense TOUTES les variables d'environnement requises par le SaaS
# LumiChart (FastAPI, Streamlit, Supabase, Google Gemini VLM, Emailing, Mobile Money).
#
# GESTION DES SECRETS (SPRINT 0 / PILIER 1) :
# 1. Ne commitez JAMAIS de vrais secrets ou clés API dans ce fichier ou dans Git.
# 2. Infisical SecretOps est la source principale de vérité pour les secrets.
#    - Installation CLI : voir docs/INFISICAL_SETUP.md
#    - Cartographie des secrets : voir docs/INFISICAL_SECRETS_MAP.md
#    - Lancement local : infisical run -- uvicorn src.app.api:app --reload --port 8088
# 3. Pour le développement local sans Infisical :
#    cp .env.example .env (puis renseigner vos clés de test)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVEUR ASGI
# ------------------------------------------------------------------------------
# Environnement d'exécution : 'development' | 'staging' | 'production' | 'test'
ENVIRONMENT=development

# Port d'écoute du serveur FastAPI
PORT=8088

# Hôte d'écoute réseau (0.0.0.0 pour écouter sur toutes les interfaces)
HOST=0.0.0.0

# Niveau de journalisation : 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL'
LOG_LEVEL=INFO

# URL publique ou locale de base de l'application
APP_BASE_URL=http://localhost:8088


# ------------------------------------------------------------------------------
# 2. SÉCURITÉ & AUTHENTIFICATION (JWT)
# ------------------------------------------------------------------------------
# Clé secrète de signature des tokens JWT (min 32 caractères aléatoires)
# Géré via Infisical : JWT_SECRET_KEY
JWT_SECRET_KEY=your_random_secure_jwt_secret_key_minimum_32_characters_long_here


# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI VISION VLM (INFERENCE MULTIMODALE)
# ------------------------------------------------------------------------------
# Clé API Google AI Studio pour le VLM Gemini (P1)
# Géré via Infisical : GEMINI_API_KEY
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# 4. SUPABASE (BASE DE DONNÉES POSTGRESQL & AUTH RLS)
# ------------------------------------------------------------------------------
# URL de l'instance Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé API publique 'anon' (requêtes publiques respectant le RLS)
SUPABASE_KEY=your_supabase_anon_public_key_jwt_here

# Clé API d'administration 'service_role' (P1 - STRICTEMENT BACKEND-ONLY !)
# Géré via Infisical : SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_jwt_here


# ------------------------------------------------------------------------------
# 5. INFRASTRUCTURE D'EMAILING TRANSACTIONNEL
# ------------------------------------------------------------------------------
# Fournisseur actif : 'maildev' (local) | 'resend' | 'brevo' | 'smtp'
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@graphein.ai
EMAIL_NAME="LumiChart Enterprise"

# Clé API Resend (P1) - Géré via Infisical : RESEND_API_KEY
# RESEND_API_KEY=re_your_resend_api_key_here

# Clé API Brevo / Sendinblue (optionnel)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Configuration SMTP classique (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@graphein.ai
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_USE_TLS=true

# Configuration MailDev local
MAILDEV_HOST=localhost
MAILDEV_PORT=1025
MAILDEV_WEB_PORT=1080


# ------------------------------------------------------------------------------
# 6. GESTION CENTRALISÉE DES SECRETS (INFISICAL SECRETOPS)
# ------------------------------------------------------------------------------
INFISICAL_ENABLED=false
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
INFISICAL_SITE_URL=https://app.infisical.com
# Machine Identity / Token (utilisé en CI/CD et production)
# INFISICAL_TOKEN=
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=


# ------------------------------------------------------------------------------
# 7. PASSERELLE MOBILE MONEY (CINETPAY - SPRINT 2)
# ------------------------------------------------------------------------------
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=


# ------------------------------------------------------------------------------
# 8. ASYNCHRONE & CACHING (REDIS / CELERY - SPRINT 3)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------------------------
# 9. OBSERVABILITÉ & SRE (PRODUCTION)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# BETTERSTACK_TOKEN=
